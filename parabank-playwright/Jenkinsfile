pipeline {
agent any

```
stages {

    stage('Install Dependencies') {
        steps {
            dir('parabank-playwright') {
                bat 'npm ci'
            }
        }
    }

    stage('Install Playwright Browsers') {
        steps {
            dir('parabank-playwright') {
                bat 'npx playwright install chromium'
            }
        }
    }

    stage('Run Tests') {
        steps {
            dir('parabank-playwright') {
                bat 'npm run full'
            }
        }
    }

    stage('Generate Allure Report') {
        steps {
            dir('parabank-playwright') {
                bat 'npx allure-commandline generate allure-results --clean -o allure-report'
            }
        }
    }
}

post {

    always {

        allure([
            includeProperties: false,
            results: [[path: 'parabank-playwright/allure-results']]
        ])

        publishHTML([
            allowMissing: true,
            alwaysLinkToLastBuild: true,
            keepAll: true,
            reportDir: 'parabank-playwright/playwright-report',
            reportFiles: 'index.html',
            reportName: 'Playwright HTML Report'
        ])

        echo 'Pipeline complete - Reports generated'
    }

    success {
        echo 'All tests passed!'
    }

    failure {
        echo 'Some tests failed - check reports'
    }
}
```

}

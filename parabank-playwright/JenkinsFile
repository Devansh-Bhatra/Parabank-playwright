pipeline {
    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                dir('parabank-playwright') {
                    bat 'npm install'
                }
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                dir('parabank-playwright') {
                    bat 'npx playwright install'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('parabank-playwright') {
                    bat 'npm run full'
                }
            }
        }

        stage('Generate Allure Report') {
            steps {
                dir('parabank-playwright') {
                    bat 'npx allure generate allure-results --clean -o allure-report'
                }
            }
        }
    }
}